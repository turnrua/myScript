using System;
using System.Linq;
using System.Numerics;
using Newtonsoft.Json;
using KodakkuAssist.Script;
using KodakkuAssist.Module.GameEvent;
using KodakkuAssist.Module.Draw;

namespace DancerHelper;

[ScriptType(guid: "70D33E2C-8080-4055-ACC3-29C91CF673A6", name: "PVP舞者提示-位置标记版", territorys: [], version: "0.0.1.18", author: "chris")]
public class DancerLinkClass
{
    [ScriptMethod(name: "闭式舞姿脚下文字", eventType: EventTypeEnum.StatusAdd, eventCondition: ["StatusID:2048"])]
    public void ClosedPositionText(Event @event, ScriptAccessory accessory)
    {
        // 逻辑：如果是别人获得了舞姿（TargetId），就在他脚下画个圈或写字
        // 如果想让自己身上也显示，就把下面这行注释掉
        // if (@event.TargetId() == accessory.Data.Me) return; 

        var dp = accessory.Data.GetDefaultDrawProperties();
        dp.Name = $"舞姿标记-{@event.TargetId()}";

        // 绑定到获得Buff的人身上
        dp.Owner = @event.TargetId();

        // 颜色参考：亮粉色
        dp.Color = new Vector4(1.0f, 0.4f, 0.8f, 1.0f);

        // 尝试使用 Circle（如果不支持Text），并使用 Imgui 模式增加成功率
        dp.Scale = new Vector2(0.3f);
        dp.DestoryAt = 1000000; // 长期持有

        // 发送绘制：采用你示例中的 Imgui 模式
        accessory.Method.SendDraw(DrawModeEnum.Imgui, DrawTypeEnum.Circle, dp);


    }

    [ScriptMethod(name: "闭式舞姿移除", eventType: EventTypeEnum.StatusRemove, eventCondition: ["StatusID:2026"])]
    public void ClosedPositionRemove(Event @event, ScriptAccessory accessory)
    {
        // 移除标记
        accessory.Method.RemoveDraw($"舞姿标记-{@event.TargetId()}");
    }
}

// 必须保留你示例中依赖的扩展方法，确保 TargetId() 等能正常解析
public static class EventExtensions
{
    private static bool ParseHexId(string? idStr, out uint id)
    {
        id = 0;
        if (string.IsNullOrEmpty(idStr)) return false;
        try
        {
            var idStr2 = idStr.Replace("0x", "");
            id = uint.Parse(idStr2, System.Globalization.NumberStyles.HexNumber);
            return true;
        }
        catch (Exception) { return false; }
    }

    public static uint TargetId(this Event @event)
    {
        return ParseHexId(@event["TargetId"], out var id) ? id : 0;
    }

    public static string TargetName(this Event @event)
    {
        return @event["TargetName"] ?? "未知";
    }
}
